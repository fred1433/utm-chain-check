# Origins an operator allows the checker to reach even when their address is private,
# as host:port, comma separated. Empty by default, and empty on the deployed page.
# UTM_CHAIN_CHECK_ALLOWLIST=127.0.0.1:3000

# When set, /api/events/summary answers to a request carrying this token in the
# x-summary-token header. Not set on the deployed page, where collected events are
# therefore not readable from the outside.
# EVENT_SUMMARY_TOKEN=

# Optional path where every accepted event is also appended as JSON lines.
# EVENT_SINK_PATH=
